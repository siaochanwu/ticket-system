NODE_ENV=development
PORT=3000

# PostgreSQL 
DATABASE_URL=

# Redis
REDIS_URL=

# JWT
# 必填，沒有預設值。正式環境（NODE_ENV=production）未設定會啟動失敗；
# 開發／測試環境未設定只會印出警告，但 JWT 簽發與票券 QR 簽章都不安全。
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 搶票設定
SEAT_LOCK_DURATION_SECONDS=600
MAX_TICKETS_PER_ORDER=4

# 訂單
ORDER_PAYMENT_TIMEOUT_MINUTES=10

# 金流（mock）
# 必填，沒有預設值。POST /api/payments/callback/mock 沒有 JWT 認證，
# 這個 secret 是唯一的驗證門檻；正式環境未設定會啟動失敗。
PAYMENT_MOCK_SECRET=
PAYMENT_CALLBACK_BASE_URL=http://localhost:3000

# 退票
REFUND_DEADLINE_DAYS=7

# 逾期訂單回收 worker
ORDER_EXPIRY_INTERVAL_MS=30000
ORDER_EXPIRY_LOCK_TTL_SECONDS=25
ORDER_EXPIRY_BATCH_SIZE=100